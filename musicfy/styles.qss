/* N3mesisFy 0.5.0 — N3mesis-inspired desktop player */

/* Global canvas */
QMainWindow#musicFyWindow {
    background: #07080a;
    color: #f4f6f8;
}
QWidget {
    background: transparent;
    color: #f4f6f8;
    font-family: "Segoe UI Variable", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}
QLabel {
    background: transparent;
    border: none;
    padding: 0;
}

/* Navigation rail */
QFrame#sidebar {
    background: #0d0e11;
    border: 1px solid #25272c;
    border-radius: 18px;
}
QLabel#brandMark {
    background: #0b3040;
    border: 2px solid #0ca9e5;
    border-radius: 12px;
}
QLabel#brand {
    color: #f5f7fa;
    font-size: 25px;
    font-weight: 850;
    letter-spacing: -1.1px;
}
QLabel#eyebrow, QLabel#version {
    color: #a2abb7;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.7px;
}
QLabel#version { color: #69717e; font-size: 8px; }
QLabel#navGroupLabel {
    color: #777f8b;
    padding: 8px 10px 3px;
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 1.6px;
}
QLabel#sidebar_note {
    color: #788391;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 1.5px;
    padding: 10px 4px;
}
QPushButton#navButton {
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 10px 10px;
    min-height: 22px;
}
QPushButton#navButton:hover {
    background: #17191d;
    border-color: #282b31;
}
QPushButton#navButton:checked {
    background: #f4f6f8;
    border-color: #f4f6f8;
}
QPushButton#navButton QLabel {
    background: transparent;
    font-size: 11px;
}

/* Headings and actions */
QLabel#pageTitle {
    color: #f5f7fa;
    font-size: 29px;
    font-weight: 850;
    letter-spacing: -1.25px;
}
QLabel#sectionTitle {
    color: #f3f5f7;
    font-size: 16px;
    font-weight: 800;
}
QLabel#muted { color: #929ba7; font-size: 10px; }
QPushButton {
    color: #e6eaf0;
    background: #111317;
    border: 1px solid #292c32;
    border-radius: 9px;
    padding: 10px 14px;
    font-weight: 650;
}
QPushButton:hover {
    background: #1a1d22;
    border-color: #3a424c;
}
QPushButton:pressed { background: #22272e; }
QPushButton:disabled { color: #626b77; background: #101114; }
QPushButton#primaryButton {
    color: #05131b;
    background: #12aee9;
    border: 1px solid #12aee9;
    font-weight: 850;
}
QPushButton#primaryButton:hover {
    background: #35c0f3;
    border-color: #35c0f3;
}
QPushButton#secondaryButton {
    color: #e1e7ee;
    background: #111317;
    border: 1px solid #292d33;
}
QPushButton#textButton {
    color: #19b4ed;
    background: transparent;
    border: 1px solid transparent;
    padding: 7px 9px;
    font-size: 10px;
    font-weight: 750;
}
QPushButton#textButton:hover {
    color: #77d8fb;
    background: rgba(18,174,233,.08);
    border-color: rgba(18,174,233,.18);
}
QLineEdit#searchBox {
    color: #f2f5f8;
    background: #101216;
    border: 1px solid #292c32;
    border-radius: 10px;
    padding: 12px 15px;
    selection-background-color: #087eaa;
}
QLineEdit#searchBox:focus {
    border: 1px solid #0da6df;
    background: #11151a;
}

/* Home hero */
QFrame#heroBanner {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #11161c, stop:.60 #101317, stop:1 #0c0e12);
    border: 1px solid #292d33;
    border-radius: 17px;
}
QLabel#heroKicker {
    color: #19b4ed;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 2px;
}
QLabel#heroTitle {
    color: #f6f8fa;
    font-size: 34px;
    font-weight: 850;
    letter-spacing: -1.6px;
}
QLabel#heroText {
    color: #a8b0bc;
    font-size: 11px;
}
QLabel#heroArtwork { background: transparent; border: none; }
QPushButton#heroButton {
    color: #06131a;
    background: #12aee9;
    border: 1px solid #12aee9;
    border-radius: 8px;
    padding: 9px 15px;
    font-size: 10px;
    font-weight: 850;
}
QPushButton#heroButton:hover { background: #35c0f3; }

/* Library metrics and empty state */
QFrame#statCard {
    background: #101216;
    border: 1px solid #272b31;
    border-radius: 12px;
}
QFrame#statCard:hover {
    background: #15191e;
    border-color: #3c444e;
}
QLabel#statIcon { color: #e2e8ef; }
QLabel#statValue {
    color: #f6f8fa;
    font-size: 22px;
    font-weight: 850;
}
QFrame#emptyStateCard {
    background: #0e1115;
    border: 1px solid #292e35;
    border-radius: 16px;
}
QLabel#emptyStateIcon {
    color: #11b0eb;
    background: #102632;
    border: 1px solid #17485d;
    border-radius: 14px;
}
QLabel#emptyStateTitle {
    color: #f4f6f8;
    font-size: 17px;
    font-weight: 800;
}
QLabel#emptyState { color: #a0aab7; font-size: 11px; }

/* Album, artist and genre cards */
QScrollArea#homeAlbumScroll,
QScrollArea#homeAlbumScroll QWidget,
QScrollArea#collectionScroll,
QScrollArea#collectionScroll QWidget {
    background: transparent;
    border: none;
}
QFrame#collectionCard {
    background: #101216;
    border: 1px solid #272b31;
    border-radius: 13px;
}
QFrame#collectionCard:hover {
    background: #171b20;
    border: 1px solid #0d92c3;
}
QLabel#collectionCover {
    background: #171b20;
    border: 1px solid #2b3037;
    border-radius: 9px;
}
QLabel#collectionTitle {
    color: #f0f3f6;
    font-size: 11px;
    font-weight: 800;
}
QLabel#collectionSubtitle { color: #8e98a5; font-size: 9px; }

/* Track table */
QTableWidget#trackTable {
    color: #e3e8ee;
    background: #0c0e11;
    alternate-background-color: #111419;
    border: 1px solid #262a30;
    border-radius: 12px;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(18,174,233,.16);
    selection-color: #ffffff;
}
QTableWidget#trackTable::item {
    padding: 8px 9px;
    border: none;
    border-bottom: 1px solid #1b1e23;
}
QTableWidget#trackTable::item:hover { background: #151a20; }
QHeaderView::section {
    color: #8f99a6;
    background: #101317;
    border: none;
    border-bottom: 1px solid #282c32;
    padding: 13px 9px;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.3px;
}

/* Bottom player */
QFrame#playerBar {
    background: #0e1014;
    border: 1px solid #2a2e35;
    border-radius: 14px;
}
QLabel#coverPlaceholder {
    background: #10232e;
    border: 1px solid #17475c;
    border-radius: 9px;
}
QLabel#nowTitle { color: #f4f6f8; font-size: 11px; font-weight: 800; }
QLabel#timeLabel { color: #818b98; font-size: 9px; min-width: 32px; }
QPushButton#controlButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 19px;
    padding: 5px;
    min-width: 36px;
    min-height: 36px;
}
QPushButton#controlButton:hover {
    background: #1a2026;
    border-color: #343b44;
}
QPushButton#playButton {
    background: #12aee9;
    border: 1px solid #12aee9;
    border-radius: 22px;
    padding: 0;
}
QPushButton#playButton:hover { background: #35c0f3; }
QSlider::groove:horizontal {
    background: #30343a;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #12aee9; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #f4f7fa;
    border: 2px solid #12aee9;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 6px;
}
QSlider#volumeSlider::groove:horizontal { height: 3px; }
QSlider#volumeSlider::handle:horizontal { width: 9px; height: 9px; margin: -4px 0; }

/* Menus, status and scrollbars */
QStatusBar {
    background: #07080a;
    color: #75808d;
    border: none;
    font-size: 10px;
}
QMenu {
    background: #14171c;
    color: #edf1f5;
    border: 1px solid #30353d;
    padding: 5px;
}
QMenu::item { padding: 8px 24px 8px 12px; border-radius: 5px; }
QMenu::item:selected { background: rgba(18,174,233,.15); }
QScrollBar:vertical {
    background: #0b0d10;
    width: 8px;
    margin: 3px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #3a424c;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #0b0d10;
    height: 7px;
    margin: 2px 12px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #3a424c;
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QMessageBox, QInputDialog, QFileDialog { background: #101216; }


/* Launcher-inspired chrome: thin studio header and horizontal capsule navigation */
QWidget#topBar { background: transparent; }
QLabel#brandMark {
    background: #0b3040;
    border: 2px solid #12aee9;
    border-radius: 10px;
}
QLabel#topBrand {
    color: #f5f7fa;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 2.3px;
}
QLabel#topBrandSeparator {
    color: #58616d;
    font-size: 13px;
    font-weight: 500;
}
QLabel#topBrandCaption {
    color: #8994a1;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 2.2px;
}
QLabel#versionPill {
    color: #aeb7c2;
    background: #101216;
    border: 1px solid #292d33;
    border-radius: 11px;
    min-width: 58px;
    min-height: 32px;
    padding: 0 9px;
    font-size: 9px;
    font-weight: 800;
}
QFrame#topNavigation {
    background: #0d0e11;
    border: 1px solid #272a30;
    border-radius: 17px;
}
QPushButton#topNavButton {
    color: #aeb9c6;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 11px;
    padding: 8px 12px;
    min-height: 40px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .6px;
}
QPushButton#topNavButton:hover {
    color: #f1f4f7;
    background: #17191d;
    border-color: #292d33;
}
QPushButton#topNavButton:checked {
    color: #101820;
    background: #f4f6f8;
    border: 1px solid #f4f6f8;
}
QPushButton#topNavButton QLabel {
    background: transparent;
    font-size: 9px;
}
QPushButton#topNavButton:checked QLabel {
    color: #101820;
}


/* N3mesisFy 0.5.0 — left navigation and M3U playlist actions */
QFrame#sidebar {
    background: #0d0e11;
    border: 1px solid #25292f;
    border-radius: 17px;
}
QLabel#brand {
    color: #f5f7fa;
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -.8px;
}
QPushButton#navButton {
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 0;
    min-height: 38px;
}
QPushButton#navButton:hover {
    background: #171a1e;
    border-color: #292f36;
}
QPushButton#navButton:checked {
    background: #f2f4f6;
    border-color: #f2f4f6;
}
QPushButton#navButton QLabel {
    color: #aeb9c6;
    background: transparent;
    font-size: 11px;
    font-weight: 650;
}
QPushButton#navButton:checked QLabel {
    color: #101820;
    font-weight: 800;
}
QPushButton#sidebarAction {
    color: #bac5d1;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 0;
    text-align: left;
    min-height: 36px;
    font-size: 10px;
}
QPushButton#sidebarAction:hover {
    color: #f3f6f9;
    background: #171a1e;
    border-color: #2b3038;
}
QPushButton#sidebarAction QLabel {
    color: #bac5d1;
    background: transparent;
    font-size: 10px;
}
QPushButton#primaryButton,
QPushButton#secondaryButton,
QPushButton#heroButton,
QPushButton#textButton,
QPushButton#controlButton,
QPushButton#playButton {
    padding: 0;
}
QPushButton#primaryButton QLabel {
    color: #06131b;
    font-weight: 800;
}
QPushButton#secondaryButton QLabel {
    color: #e1e7ee;
    font-weight: 700;
}
QPushButton#dangerButton {
    color: #ffdce0;
    background: #241216;
    border: 1px solid #51252d;
    border-radius: 9px;
    padding: 0;
}
QPushButton#dangerButton:hover {
    background: #35171d;
    border-color: #a13a4a;
}
QPushButton#dangerButton QLabel {
    color: #ff9eaa;
    background: transparent;
}
QPushButton#playButton QLabel { background: transparent; }
QPushButton#controlButton QLabel { background: transparent; }
QPushButton#controlButton:checked {
    background: rgba(18,174,233,.12);
    border: 1px solid rgba(18,174,233,.28);
}
QDialog {
    background: #101216;
    color: #edf1f5;
}
QListWidget#queueList {
    background: #0c0f13;
    color: #e5ebf2;
    border: 1px solid #292f36;
    border-radius: 10px;
    padding: 6px;
}
QListWidget#queueList::item {
    padding: 10px;
    border-bottom: 1px solid #20252c;
}
QListWidget#queueList::item:selected {
    color: #f4f8fb;
    background: rgba(18,174,233,.18);
}


/* Home experience refinements */
QScrollArea#homePageScroll,
QScrollArea#homePageScroll QWidget {
    background: transparent;
    border: none;
}
QFrame#heroBanner {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #14232d, stop:.55 #10171e, stop:1 #0b1015);
    border: 1px solid #28343c;
    border-radius: 18px;
}
QLabel#heroArtwork {
    background: #10232e;
    border: 1px solid #244a5d;
    border-radius: 14px;
}
QLabel#heroTitle {
    font-size: 32px;
    letter-spacing: -1.2px;
}
QLabel#heroText {
    color: #b8c3ce;
    font-size: 12px;
    font-weight: 550;
}
QFrame#statCard {
    background: #0f1216;
    border: 1px solid #252c33;
    border-radius: 12px;
}
QFrame#statCard:hover {
    background: #151b21;
    border-color: #315366;
}
QLabel#statValue {
    font-size: 21px;
}
QFrame#collectionCard {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 13px;
}
QFrame#collectionCard:hover {
    background: #12171d;
    border: 1px solid #27343e;
}
QLabel#collectionCover {
    background: #161c23;
    border: 1px solid #2a3037;
    border-radius: 11px;
}
QLabel#collectionTitle {
    color: #f0f3f6;
    font-size: 12px;
    font-weight: 750;
}
QLabel#collectionSubtitle {
    color: #8d9aa8;
    font-size: 10px;
}


QFrame#collectionArtwork {
    background: #10151a;
    border: none;
    border-radius: 11px;
}
QPushButton#cardPlayButton {
    color: #07131b;
    background: #12b8ee;
    border: 1px solid rgba(255,255,255,.42);
    border-radius: 20px;
    padding: 0;
}
QPushButton#cardPlayButton:hover {
    background: #65d5f7;
    border-color: #d9f6ff;
}
QPushButton#cardPlayButton QLabel {
    color: #07131b;
    background: transparent;
}


/* N3mesisFy 0.5 — focused listening experience */
QFrame#heroBanner {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #162b37, stop:.52 #101a22, stop:1 #0c1117);
    border: 1px solid #2b414d;
    border-radius: 20px;
}
QLabel#heroTitle {
    color: #f5f8fb;
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -1.4px;
}
QLabel#heroText {
    color: #c0cbd5;
    font-size: 12px;
    font-weight: 600;
}
QLabel#heroArtwork {
    background: #101f28;
    border: 1px solid #2a4b5a;
    border-radius: 16px;
}
QPushButton#heroButton {
    color: #06131b;
    background: #12b8ee;
    border: 1px solid #12b8ee;
    border-radius: 10px;
    padding: 0 18px;
    min-height: 42px;
    font-size: 11px;
    font-weight: 850;
}
QPushButton#heroButton QLabel {
    color: #06131b;
    background: transparent;
    font-weight: 850;
}
QPushButton#heroButton:hover { background: #67d6f7; }
QScrollArea#homePageScroll,
QScrollArea#homePageScroll QWidget#homePageContent {
    background: transparent;
    border: none;
}
QFrame#playerBar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #121820, stop:.52 #0e1319, stop:1 #10161d);
    border: 1px solid #2b343d;
    border-radius: 16px;
}
QLabel#nowTitle { font-size: 12px; font-weight: 850; }
QLabel#nowPlayingCover {
    background: #101820;
    border: 1px solid #2e4654;
    border-radius: 18px;
}
QDialog#nowPlayingDialog,
QDialog#queueDialog {
    background: #080b0f;
    color: #f3f6f8;
}
QLabel#nowPlayingTitle {
    color: #f5f7fa;
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -1.4px;
}
QLabel#nowPlayingArtist {
    color: #b0bdc8;
    font-size: 17px;
    font-weight: 600;
}
QLabel#nowPlayingDialog QLabel#eyebrow {
    color: #18b9ed;
}
QDialog#nowPlayingDialog QPushButton#primaryButton {
    min-height: 42px;
    padding: 0 18px;
}
QDialog#nowPlayingDialog QPushButton#secondaryButton {
    min-height: 42px;
    padding: 0 18px;
}
QListWidget#queueList::item {
    min-height: 36px;
    padding: 11px 12px;
    border-radius: 7px;
}
QListWidget#queueList::item:selected {
    background: rgba(18,184,238,.20);
    border: 1px solid rgba(18,184,238,.35);
}
QListWidget#queueList::item:hover {
    background: #19222b;
}
QPushButton#controlButton:hover {
    background: rgba(18,184,238,.12);
    border-color: rgba(18,184,238,.24);
}
QPushButton#controlButton#fullPlayerButton {
    color: #c6d3df;
}


/* N3mesisFy 0.6 — listening tools and focused player */
QPushButton#playerTab {
    color: #8797a7;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 1px;
}
QPushButton#playerTab:hover {
    color: #eef4f8;
    background: #151c23;
}
QPushButton#playerTab:checked {
    color: #b9edff;
    background: rgba(18,184,238,.12);
    border: 1px solid rgba(18,184,238,.25);
}
QLabel#lyricsText {
    color: #e2ebf2;
    font-size: 20px;
    font-weight: 650;
    padding: 26px 40px;
    background: transparent;
}
QPushButton#replayGainButton {
    color: #8b9aaa;
    background: #111820;
    border: 1px solid #293641;
    border-radius: 8px;
    min-width: 35px;
    min-height: 30px;
    padding: 0 7px;
    font-size: 9px;
    font-weight: 900;
}
QPushButton#replayGainButton:hover {
    color: #dceaf2;
    border-color: #3c6378;
}
QPushButton#replayGainButton:checked {
    color: #07131b;
    background: #66d6f7;
    border-color: #66d6f7;
}
QPushButton#controlButton:checked {
    color: #b9edff;
    background: rgba(18,184,238,.14);
    border: 1px solid rgba(18,184,238,.3);
}
QLabel#heroKicker {
    color: #27c0ee;
}
QLabel#sectionTitle {
    color: #f3f6f8;
    font-size: 18px;
    font-weight: 850;
    letter-spacing: -.25px;
}
QLabel#collectionSubtitle {
    color: #91a1af;
}
QFrame#playerBar {
    background: #0e141b;
    border: 1px solid #2b3944;
}
