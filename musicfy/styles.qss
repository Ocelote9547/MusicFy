/* MusicFy 0.3.1 — N3mesis-inspired dark desktop UI */

/* Global canvas */
QMainWindow#musicFyWindow {
    background: #07080a;
    color: #f4f6f8;
}
QWidget {
    background: transparent;
    color: #f4f6f8;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}
QLabel {
    background: transparent;
    border: none;
    padding: 0;
}

/* Navigation rail */
QFrame#sidebar {
    background: #0d0e11;
    border: 1px solid #25272c;
    border-radius: 18px;
}
QLabel#brandMark {
    background: #0b3040;
    border: 2px solid #0ca9e5;
    border-radius: 12px;
}
QLabel#brand {
    color: #f5f7fa;
    font-size: 25px;
    font-weight: 850;
    letter-spacing: -1.1px;
}
QLabel#eyebrow, QLabel#version {
    color: #a2abb7;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.7px;
}
QLabel#version { color: #69717e; font-size: 8px; }
QLabel#navGroupLabel {
    color: #777f8b;
    padding: 8px 10px 3px;
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 1.6px;
}
QLabel#sidebar_note {
    color: #788391;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 1.5px;
    padding: 10px 4px;
}
QPushButton#navButton {
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 10px 10px;
    min-height: 22px;
}
QPushButton#navButton:hover {
    background: #17191d;
    border-color: #282b31;
}
QPushButton#navButton:checked {
    background: #f4f6f8;
    border-color: #f4f6f8;
}
QPushButton#navButton QLabel {
    background: transparent;
    font-size: 11px;
}

/* Headings and actions */
QLabel#pageTitle {
    color: #f5f7fa;
    font-size: 29px;
    font-weight: 850;
    letter-spacing: -1.25px;
}
QLabel#sectionTitle {
    color: #f3f5f7;
    font-size: 16px;
    font-weight: 800;
}
QLabel#muted { color: #929ba7; font-size: 10px; }
QPushButton {
    color: #e6eaf0;
    background: #111317;
    border: 1px solid #292c32;
    border-radius: 9px;
    padding: 10px 14px;
    font-weight: 650;
}
QPushButton:hover {
    background: #1a1d22;
    border-color: #3a424c;
}
QPushButton:pressed { background: #22272e; }
QPushButton:disabled { color: #626b77; background: #101114; }
QPushButton#primaryButton {
    color: #05131b;
    background: #12aee9;
    border: 1px solid #12aee9;
    font-weight: 850;
}
QPushButton#primaryButton:hover {
    background: #35c0f3;
    border-color: #35c0f3;
}
QPushButton#secondaryButton {
    color: #e1e7ee;
    background: #111317;
    border: 1px solid #292d33;
}
QPushButton#textButton {
    color: #19b4ed;
    background: transparent;
    border: 1px solid transparent;
    padding: 7px 9px;
    font-size: 10px;
    font-weight: 750;
}
QPushButton#textButton:hover {
    color: #77d8fb;
    background: rgba(18,174,233,.08);
    border-color: rgba(18,174,233,.18);
}
QLineEdit#searchBox {
    color: #f2f5f8;
    background: #101216;
    border: 1px solid #292c32;
    border-radius: 10px;
    padding: 12px 15px;
    selection-background-color: #087eaa;
}
QLineEdit#searchBox:focus {
    border: 1px solid #0da6df;
    background: #11151a;
}

/* Home hero */
QFrame#heroBanner {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #11161c, stop:.60 #101317, stop:1 #0c0e12);
    border: 1px solid #292d33;
    border-radius: 17px;
}
QLabel#heroKicker {
    color: #19b4ed;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 2px;
}
QLabel#heroTitle {
    color: #f6f8fa;
    font-size: 34px;
    font-weight: 850;
    letter-spacing: -1.6px;
}
QLabel#heroText {
    color: #a8b0bc;
    font-size: 11px;
}
QLabel#heroArtwork { background: transparent; border: none; }
QPushButton#heroButton {
    color: #06131a;
    background: #12aee9;
    border: 1px solid #12aee9;
    border-radius: 8px;
    padding: 9px 15px;
    font-size: 10px;
    font-weight: 850;
}
QPushButton#heroButton:hover { background: #35c0f3; }

/* Library metrics and empty state */
QFrame#statCard {
    background: #101216;
    border: 1px solid #272b31;
    border-radius: 12px;
}
QFrame#statCard:hover {
    background: #15191e;
    border-color: #3c444e;
}
QLabel#statIcon { color: #e2e8ef; }
QLabel#statValue {
    color: #f6f8fa;
    font-size: 22px;
    font-weight: 850;
}
QFrame#emptyStateCard {
    background: #0e1115;
    border: 1px solid #292e35;
    border-radius: 16px;
}
QLabel#emptyStateIcon {
    color: #11b0eb;
    background: #102632;
    border: 1px solid #17485d;
    border-radius: 14px;
}
QLabel#emptyStateTitle {
    color: #f4f6f8;
    font-size: 17px;
    font-weight: 800;
}
QLabel#emptyState { color: #a0aab7; font-size: 11px; }

/* Album, artist and genre cards */
QScrollArea#homeAlbumScroll,
QScrollArea#homeAlbumScroll QWidget,
QScrollArea#collectionScroll,
QScrollArea#collectionScroll QWidget {
    background: transparent;
    border: none;
}
QFrame#collectionCard {
    background: #101216;
    border: 1px solid #272b31;
    border-radius: 13px;
}
QFrame#collectionCard:hover {
    background: #171b20;
    border: 1px solid #0d92c3;
}
QLabel#collectionCover {
    background: #171b20;
    border: 1px solid #2b3037;
    border-radius: 9px;
}
QLabel#collectionTitle {
    color: #f0f3f6;
    font-size: 11px;
    font-weight: 800;
}
QLabel#collectionSubtitle { color: #8e98a5; font-size: 9px; }

/* Track table */
QTableWidget#trackTable {
    color: #e3e8ee;
    background: #0c0e11;
    alternate-background-color: #111419;
    border: 1px solid #262a30;
    border-radius: 12px;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(18,174,233,.16);
    selection-color: #ffffff;
}
QTableWidget#trackTable::item {
    padding: 8px 9px;
    border: none;
    border-bottom: 1px solid #1b1e23;
}
QTableWidget#trackTable::item:hover { background: #151a20; }
QHeaderView::section {
    color: #8f99a6;
    background: #101317;
    border: none;
    border-bottom: 1px solid #282c32;
    padding: 13px 9px;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.3px;
}

/* Bottom player */
QFrame#playerBar {
    background: #0e1014;
    border: 1px solid #2a2e35;
    border-radius: 14px;
}
QLabel#coverPlaceholder {
    background: #10232e;
    border: 1px solid #17475c;
    border-radius: 9px;
}
QLabel#nowTitle { color: #f4f6f8; font-size: 11px; font-weight: 800; }
QLabel#timeLabel { color: #818b98; font-size: 9px; min-width: 32px; }
QPushButton#controlButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 19px;
    padding: 5px;
    min-width: 36px;
    min-height: 36px;
}
QPushButton#controlButton:hover {
    background: #1a2026;
    border-color: #343b44;
}
QPushButton#playButton {
    background: #12aee9;
    border: 1px solid #12aee9;
    border-radius: 22px;
    padding: 0;
}
QPushButton#playButton:hover { background: #35c0f3; }
QSlider::groove:horizontal {
    background: #30343a;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #12aee9; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #f4f7fa;
    border: 2px solid #12aee9;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 6px;
}
QSlider#volumeSlider::groove:horizontal { height: 3px; }
QSlider#volumeSlider::handle:horizontal { width: 9px; height: 9px; margin: -4px 0; }

/* Menus, status and scrollbars */
QStatusBar {
    background: #07080a;
    color: #75808d;
    border: none;
    font-size: 10px;
}
QMenu {
    background: #14171c;
    color: #edf1f5;
    border: 1px solid #30353d;
    padding: 5px;
}
QMenu::item { padding: 8px 24px 8px 12px; border-radius: 5px; }
QMenu::item:selected { background: rgba(18,174,233,.15); }
QScrollBar:vertical {
    background: #0b0d10;
    width: 8px;
    margin: 3px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #3a424c;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #0b0d10;
    height: 7px;
    margin: 2px 12px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #3a424c;
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QMessageBox, QInputDialog, QFileDialog { background: #101216; }
