/* MusicFy 0.2.1 — AURORA desktop design system */

/* Global canvas: widgets are transparent by default.
   Only named surfaces below paint their own background. */
QMainWindow#musicFyWindow {
    background: #090d14;
    color: #f4f7fb;
}
QWidget {
    background: transparent;
    color: #f4f7fb;
    font-family: "DM Sans", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}
QLabel {
    background: transparent;
    border: none;
    padding: 0;
}

/* Sidebar */
QFrame#sidebar {
    background: #0d1623;
    border: 1px solid rgba(164, 190, 222, 0.11);
    border-radius: 18px;
}
QLabel#brandMark {
    color: #0a1220;
    background: qradialgradient(cx:0.3,cy:0.2,radius:1,
        stop:0 #d7e3ff, stop:1 #789eff);
    border: 1px solid rgba(198,215,255,.34);
    border-radius: 12px;
    font-size: 23px;
    font-weight: 900;
}
QLabel#brand {
    color: #f4f7fb;
    font-size: 26px;
    font-weight: 850;
    letter-spacing: -1.2px;
}
QLabel#eyebrow, QLabel#version {
    color: #9bb7ff;
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 1.7px;
}
QLabel#version { color: #64758e; font-size: 8px; }
QLabel#navGroupLabel {
    color: #667991;
    padding: 7px 10px 2px;
    font-size: 8px;
    font-weight: 850;
    letter-spacing: 1.7px;
}
QLabel#sidebar_note {
    color: #71839d;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 1.5px;
    padding: 10px 4px;
}
QPushButton#navButton {
    text-align: left;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 11px 10px;
    color: #a6b4c8;
    background: transparent;
    font-size: 11px;
    font-weight: 650;
}
QPushButton#navButton:hover {
    color: #f4f7fb;
    background: rgba(255,255,255,.045);
}
QPushButton#navButton:checked {
    color: #d4e0ff;
    background: rgba(142,175,255,.13);
    border: 1px solid rgba(142,175,255,.20);
}

/* Typography and common controls */
QLabel#pageTitle {
    color: #f5f7fd;
    font-size: 29px;
    font-weight: 850;
    letter-spacing: -1.3px;
}
QLabel#sectionTitle {
    color: #f2f5fb;
    font-size: 16px;
    font-weight: 800;
}
QLabel#muted { color: #93a3ba; font-size: 10px; }
QPushButton {
    color: #dce6f5;
    background: #111c2a;
    border: 1px solid rgba(164,190,222,.14);
    border-radius: 9px;
    padding: 10px 14px;
    font-weight: 650;
}
QPushButton:hover {
    background: #1a2a40;
    border-color: rgba(142,175,255,.42);
}
QPushButton:pressed { background: #203653; }
QPushButton:disabled { color: #66758b; background: #101722; }
QPushButton#primaryButton {
    color: #0a1423;
    background: #9bb6ff;
    border: 1px solid #9bb6ff;
    font-weight: 850;
}
QPushButton#primaryButton:hover { background: #c5d4ff; }
QPushButton#secondaryButton { background: #111c2a; }
QPushButton#textButton {
    color: #a9c0ff;
    background: transparent;
    border: 1px solid transparent;
    padding: 7px 9px;
    font-size: 10px;
    font-weight: 750;
}
QPushButton#textButton:hover {
    color: #edf2ff;
    background: rgba(142,175,255,.08);
    border-color: rgba(142,175,255,.15);
}
QLineEdit#searchBox {
    color: #f3f6fc;
    background: #111b29;
    border: 1px solid rgba(165,190,230,.14);
    border-radius: 10px;
    padding: 12px 15px;
    selection-background-color: #456dc6;
}
QLineEdit#searchBox:focus {
    border: 1px solid rgba(142,175,255,.68);
    background: #131f30;
}

/* Home hero */
QFrame#heroBanner {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #1b2e4b, stop:.58 #13243a, stop:1 #101a2a);
    border: 1px solid rgba(142,175,255,.28);
    border-radius: 18px;
}
QLabel#heroKicker {
    color: #a9c0ff;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 2px;
}
QLabel#heroTitle {
    color: #f5f7ff;
    font-size: 34px;
    font-weight: 850;
    letter-spacing: -1.6px;
}
QLabel#heroText {
    color: #bac7dc;
    font-size: 11px;
}
QLabel#heroArtwork {
    background: transparent;
    border: none;
    padding: 0;
}
QPushButton#heroButton {
    color: #0a1423;
    background: #b2c7ff;
    border: 1px solid #b2c7ff;
    border-radius: 18px;
    padding: 9px 16px;
    font-size: 10px;
    font-weight: 850;
}
QPushButton#heroButton:hover { background: #d3deff; }

/* Library statistics and empty state */
QFrame#statCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #17263a, stop:1 #101a28);
    border: 1px solid rgba(169,190,230,.12);
    border-radius: 13px;
}
QFrame#statCard:hover {
    border-color: rgba(142,175,255,.30);
    background: #192b43;
}
QLabel#statIcon {
    color: #a9c0ff;
    font-size: 23px;
    font-weight: 800;
}
QLabel#statValue {
    color: #f5f7ff;
    font-size: 22px;
    font-weight: 850;
}
QFrame#emptyStateCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #142338, stop:.55 #101c2b, stop:1 #121d2d);
    border: 1px solid rgba(142,175,255,.20);
    border-radius: 17px;
}
QLabel#emptyStateIcon {
    color: #b6caff;
    background: qradialgradient(cx:.4,cy:.3,radius:.8,
        stop:0 #344d79, stop:1 #1a2b44);
    border: 1px solid rgba(182,202,255,.25);
    border-radius: 15px;
    font-size: 29px;
    font-weight: 800;
}
QLabel#emptyStateTitle {
    color: #f4f7fb;
    font-size: 17px;
    font-weight: 800;
}
QLabel#emptyState {
    color: #a7b5ca;
    font-size: 11px;
}

/* Album, artist and genre cards */
QScrollArea#homeAlbumScroll,
QScrollArea#homeAlbumScroll QWidget,
QScrollArea#collectionScroll,
QScrollArea#collectionScroll QWidget {
    background: transparent;
    border: none;
}
QFrame#collectionCard {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #152337, stop:1 #101a28);
    border: 1px solid rgba(165,190,230,.12);
    border-radius: 15px;
}
QFrame#collectionCard:hover {
    background: #1a2b43;
    border: 1px solid rgba(142,175,255,.50);
}
QLabel#collectionCover {
    background: #1a2940;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
}
QLabel#collectionTitle {
    color: #f2f5fb;
    font-size: 11px;
    font-weight: 800;
}
QLabel#collectionSubtitle {
    color: #8f9fb6;
    font-size: 9px;
}

/* Track listing */
QTableWidget#trackTable {
    color: #d9e2ef;
    background: #0d141e;
    alternate-background-color: #111c2a;
    border: 1px solid rgba(164,190,222,.11);
    border-radius: 13px;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(142,175,255,.18);
    selection-color: #ffffff;
}
QTableWidget#trackTable::item {
    padding: 8px 9px;
    border: none;
    border-bottom: 1px solid rgba(164,190,222,.045);
}
QTableWidget#trackTable::item:hover { background: rgba(142,175,255,.07); }
QHeaderView::section {
    color: #8495ad;
    background: #101a27;
    border: none;
    border-bottom: 1px solid rgba(164,190,222,.10);
    padding: 13px 9px;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

/* Persistent player */
QFrame#playerBar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #15253a, stop:.5 #111d2e, stop:1 #101a29);
    border: 1px solid rgba(142,175,255,.23);
    border-radius: 16px;
}
QLabel#coverPlaceholder {
    color: #c6d7ff;
    background: #1c2d48;
    border: 1px solid rgba(142,175,255,.25);
    border-radius: 10px;
    font-size: 22px;
}
QLabel#nowTitle { color: #f4f7fb; font-size: 11px; font-weight: 800; }
QLabel#timeLabel { color: #8798af; font-size: 9px; min-width: 32px; }
QPushButton#controlButton {
    color: #dce6f5;
    background: transparent;
    border: none;
    border-radius: 18px;
    font-size: 16px;
    padding: 7px;
    min-width: 34px;
}
QPushButton#controlButton:hover { background: rgba(142,175,255,.12); }
QPushButton#playButton {
    color: #0b1525;
    background: #9bb6ff;
    border: 1px solid #9bb6ff;
    border-radius: 21px;
    font-size: 16px;
    font-weight: 900;
}
QPushButton#playButton:hover { background: #c5d4ff; }

/* Progress and volume */
QSlider::groove:horizontal {
    background: #283548;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #8eafff;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #c6d7ff;
    border: 2px solid #8eafff;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 6px;
}
QSlider#volumeSlider::groove:horizontal { height: 3px; }
QSlider#volumeSlider::handle:horizontal {
    width: 9px;
    height: 9px;
    margin: -4px 0;
}

/* Menus, status and scrollbars */
QStatusBar {
    background: #090d14;
    color: #74839a;
    border: none;
    font-size: 10px;
}
QMenu {
    background: #142031;
    color: #e8eff9;
    border: 1px solid rgba(142,175,255,.22);
    padding: 5px;
}
QMenu::item { padding: 8px 24px 8px 12px; border-radius: 5px; }
QMenu::item:selected { background: rgba(142,175,255,.18); }
QScrollBar:vertical {
    background: #0b121b;
    width: 8px;
    margin: 3px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #34445d;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #0d1724;
    height: 7px;
    margin: 2px 12px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #344965;
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QMessageBox, QInputDialog, QFileDialog { background: #111a25; }
